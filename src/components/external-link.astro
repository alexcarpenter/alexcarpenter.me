---
import { Icon } from "astro-icon/components";
import { externalLinkClass, externalLinkIconClass } from "@/lib/external-link";
const {
  href,
  text,
  class: className,
  rel = "noopener noreferrer",
} = Astro.props;
---

{/* prettier-ignore */}
<a
  href={href}
  target="_blank"
  rel={rel}
  class:list={[externalLinkClass, className]}
  >{text}<Icon
    name="arrow-up-right"
    aria-hidden="true"
    class={externalLinkIconClass}
  /></a
>
