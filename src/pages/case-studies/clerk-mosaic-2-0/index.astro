---
import BaseLayout from "@/layouts/base-layout.astro";
import ExternalLink from "@/components/external-link.astro";
---

<BaseLayout title="Clerk Mosaic 2.0">
  <section class="mt-20 px-4 lg:px-20">
    <div
      class="mx-auto grid max-w-prose grid-cols-1 items-start gap-x-10 gap-y-5 lg:max-w-none lg:grid-cols-[1fr_65ch_1fr]"
    >
      <h2
        class="text-foreground font-headline text-2xl text-balance lg:col-span-full lg:grid lg:grid-cols-subgrid"
      >
        <span class="text-muted-foreground">Clerk</span> Mosaic 2.0
      </h2>
      <p class="text-muted-foreground text-balance lg:col-start-2">
        Rebuilding Clerk components for the agentic era and for humans too I
        guess.
      </p>
    </div>
  </section>

  <section class="border-separator mt-20 border-t px-4 pt-20 lg:px-20">
    <div
      class="mx-auto grid max-w-prose grid-cols-1 items-start gap-10 lg:max-w-none lg:grid-cols-[1fr_65ch_1fr]"
    >
      <div class="prose lg:col-start-2">
        <p>
          Lorem, ipsum dolor sit amet consectetur adipisicing elit. At
          laboriosam sint quas aliquid asperiores non, totam distinctio quis,
          voluptatum fuga eius, eum error earum voluptatibus cupiditate vel
          adipisci ab illum.
        </p>
      </div>
      <div class="prose lg:col-start-2">
        <p>
          Lorem, ipsum dolor sit amet consectetur adipisicing elit. At
          laboriosam sint quas aliquid asperiores non, totam distinctio quis,
          voluptatum fuga eius, eum error earum voluptatibus cupiditate vel
          adipisci ab illum.
        </p>
      </div>
      <div class="prose lg:col-start-2">
        <p>
          Lorem, ipsum dolor sit amet consectetur adipisicing elit. At
          laboriosam sint quas aliquid asperiores non, totam distinctio quis,
          voluptatum fuga eius, eum error earum voluptatibus cupiditate vel
          adipisci ab illum.
        </p>
      </div>
    </div>
  </section>

