---
import BaseLayout from "@/layouts/base-layout.astro";
---

<BaseLayout title="Case studies // Clerk Mosaic 2.0">
  <section class="mt-40 px-4 lg:px-20">
    <div
      class="mx-auto grid max-w-prose grid-cols-1 items-start gap-y-5 lg:max-w-none lg:grid-cols-[1fr_65ch_1fr]"
    >
      <h2
        class="text-foreground font-headline text-xl text-balance lg:col-span-full lg:grid lg:grid-cols-subgrid"
      >
        <span class="text-muted-foreground">Clerk</span> Mosaic 2.0
      </h2>
      <p class="text-muted-foreground text-pretty lg:col-start-2">
        Rebuilding Clerks components for the agentic era. Improving component
        architecture and internal DX.
      </p>
    </div>
  </section>
</BaseLayout>
