---
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry, InferEntrySchema } from "astro:content";
import BaseLayout from "@/layouts/base-layout.astro";
import ExternalLink from "@/components/external-link.astro";

type CaseStudy = CollectionEntry<"caseStudies">;

type PublishedCaseStudy = CaseStudy & {
  data: Omit<CaseStudy["data"], "published"> & {
    published: Date;
  };
};

function isPublished(caseStudy: CaseStudy): caseStudy is PublishedCaseStudy {
  return caseStudy.data.published instanceof Date;
}

const caseStudies = (await getCollection("caseStudies"))
  .filter(isPublished)
  .toSorted((a, b) => b.data.published.getTime() - a.data.published.getTime());

const renderedCaseStudies = await Promise.all(
  caseStudies.map(async (caseStudy) => {
    const [{ Content }, company] = await Promise.all([
      render(caseStudy),
      getEntry(caseStudy.data.company),
    ]);

    return {
      caseStudy,
      company,
      Content,
    };
  }),
);
---

<BaseLayout title="Case studies">
  <section class="mt-20 px-4">
    <div class="mx-auto max-w-prose">
      <h2 class="text-muted-foreground font-headline text-2xl text-balance">
        <span class="text-foreground">Case studies</span> in-progress and shipped.
      </h2>
    </div>
  </section>

  {
    renderedCaseStudies.map(async ({ caseStudy, company, Content }) => {
      return (
        <section class="border-separator mt-20 border-t px-4 pt-20 lg:px-20">
          <div class="mx-auto grid max-w-prose grid-cols-1 items-start gap-10 lg:max-w-none lg:grid-cols-[1fr_65ch_1fr]">
            <h2 class="text-muted-foreground font-headline text-2xl text-balance lg:col-span-full lg:grid lg:grid-cols-subgrid">
              {company.data.company}{" "}
              <span class="text-foreground lg:first-letter:uppercase">
                {caseStudy.data.title}
              </span>
            </h2>
            <dl class="[&_dt]:text-muted-foreground max-lg:hidden">
              <dt>Link</dt>
              <dd>
                <ExternalLink text="clerk.com" href="/" />
              </dd>
            </dl>
            <div class="prose prose-longform">
              <Content />
            </div>
            <dl class="[&_dt]:text-muted-foreground lg:text-right">
              <dt class="lg:hidden">Link</dt>
              <dd class="lg:hidden">
                <ExternalLink text="clerk.com" href="/" />
              </dd>
              <dt class="max-lg:mt-5">Published</dt>
              <dd>
                <time datetime={caseStudy.data.published.toISOString()}>
                  {new Date(caseStudy.data.published).toLocaleDateString(
                    "en-US",
                    {
                      year: "numeric",
                      month: "short",
                    },
                  )}
                </time>
              </dd>
              <dt class="mt-5">Status</dt>
              <dd class="uppercase">{caseStudy.data.status}</dd>
            </dl>
          </div>
        </section>
      );
    })
  }
</BaseLayout>
