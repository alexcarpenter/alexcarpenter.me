{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alexcarpenter-me",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-26",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "alexcarpenter.me/*",
      "zone_name": "alexcarpenter.me",
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/"],
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
}
